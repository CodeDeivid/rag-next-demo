# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template versioned
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/

# local model cache (transformers.js)
/.cache/

# local tooling, machine specific
/.claude/
CLAUDE.local.md

# generated by next dev for editor tooling
AGENTS.md

# storybook
/storybook-static/
*.log
