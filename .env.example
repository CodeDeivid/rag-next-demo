# Local Postgres from docker-compose (port 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgres://rag:rag@localhost:5433/rag
# Free key from https://openrouter.ai/keys (no credit card needed)
OPENROUTER_API_KEY=
# Any model id ending in ":free" from https://openrouter.ai/models?q=free
# Fallback if this one starts returning 429: recursive/flint-v1.0:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Free embeddings model (multilingual, 2048 dimensions; the schema is sized for it).
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Optional: public URL for link previews. On Vercel it is picked up automatically.
# NEXT_PUBLIC_SITE_URL=https://your-demo.vercel.app
